<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgViewExtItem"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_weight="0.4"

        android:textAlignment="center"
        app:srcCompat="@drawable/baseline_attach_money_24"
        android:contentDescription="@string/icon_spinner_cat" />

    <TextView
        android:id="@+id/txtViewExtItem"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"


        android:gravity="center_horizontal|start|center_vertical"
        android:textColor="@color/brown_100"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
